# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (local stack: `pnpm db:start` prints these values)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by Edge Functions and admin scripts; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (magic link redirects, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Error tracking (Phase 7)
SENTRY_DSN=
